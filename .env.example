# Copy to .env and fill in. Never commit .env — it is currently tracked in
# this repository, so any value placed in it becomes public.

GOOGLE_API_KEY=
MODEL=gemini-2.0-flash
SITES_TRUSTED_SOURCE=

# XTrace Memory — https://app.xtrace.ai -> Settings -> API Keys
# Omit to run the pipeline without the memory layer.
XTRACE=
